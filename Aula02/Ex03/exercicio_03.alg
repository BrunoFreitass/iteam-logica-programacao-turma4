algoritmo "Exercicio_03"
var
   //varieveis, como são numeros inteiros, funçao real
   numero, dobro: real
inicio
   //Entrada de dados
   escreva("Digite um número: ")
   leia(numero)
   //Processamento
   dobro <- numero * 2
   //Saída de dados
   escreva("O dobro de ", numero, " é ", dobro)
fimalgoritmo