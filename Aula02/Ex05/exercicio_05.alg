algoritmo "Exercicio_05"
var
   numero: real
inicio
   //Entrada de dados
   escreva("Digite um número: ")
   leia(numero)
   //Processamento e Saída de dados
   se (numero > 0) entao
      escreva("O número ", numero, " é positivo.")
   senao
      escreva("O número ", numero, " é negativo.")
   fimse
fimalgoritmo