algoritmo "ÁreaTriangulo"
var
    base, altura, area: real
inicio
    //Entrada de dados
    escreva("Digite a base do triângulo: ")
    leia(base)
    escreva("Digite a altura do triângulo: ")
    leia(altura)
    //Cálculo da área
    area := (base * altura) / 2
    //Saída de dados
    escreva("A área do triângulo é: ", area)
fimalgoritmo
