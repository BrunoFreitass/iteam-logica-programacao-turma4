algoritmo "Exercicio_08"
var
   i, N, soma: inteiro 
inicio
   escreva("Digite um número inteiro: ")
   leia(N)
   soma <- 0
   i <- 1
   enquanto i <= N faca
      soma <- soma + i
      i <- i + 1
   fimenquanto
   escreval("A soma de todos os números de 1 até ", N, " é: ", soma)
fimalgoritmo

//## Enunciado
//Leia um número inteiro N e calcule a soma de todos os números de 1 até N.