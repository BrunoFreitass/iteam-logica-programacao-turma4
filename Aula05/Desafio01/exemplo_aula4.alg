Algoritmo "exercicio13"
Var
   numero: inteiro
inicio
   repita
      escreval("Informe um numero inteiro positivo: ")
      leia(numero)
   ate (numero > 0)
   
   escreval("O numero informado foi: ", numero)
fimalgoritmo


//Exercicio 13 - numero positivo: Solicite ao usuario um numero inteiro, repita a leitura até que 
//seja informado um numero maior que zero. Depois exiba o numero informado.