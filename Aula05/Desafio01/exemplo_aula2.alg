algoritmo "Login"
var
senha: inteiro
inicio
   escreval("Digite sua senha: ")
    leia(senha)
    enquanto senha <> 1234 faca
        escreval("Senha incorreta! Tente novamente.")
        escreval("Digite sua senha: ")
        leia(senha)
    fimenquanto
    escreval("Acesso permitido!")
fimalgoritmo