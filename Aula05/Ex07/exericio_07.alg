algoritmo "Exercicio_07"
var
   i: inteiro
inicio
   i <- 1
   enquanto (i <= 100) faca
      se (i mod 2 = 0) entao
         escreval(i)
      fimse
      i <- i + 1
   fimenquanto
fimalgoritmo


//## Enunciado
//Exiba todos os números pares entre 1 e 100.
//## Dica
//Utilize uma estrutura de repetição e uma condição para verificar se o número é par.